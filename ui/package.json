{
  "name": "pedagogue-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pedagogue UI: TypeScript sources bundled by esbuild into dist/ and served by pedagogue-server.",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node build.mjs && node --test \"test/*.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^7.0.2"
  }
}
